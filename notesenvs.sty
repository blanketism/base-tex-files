\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notesenvs}
\RequirePackage{pifont}

% Color Settings

\definecolor{defcolor}{HTML}{592CD4}
\definecolor{theocolor}{HTML}{C42114}
\definecolor{propcolor}{HTML}{3EA8B5}
\definecolor{corcolor}{HTML}{2EA62F}
\definecolor{lemcolor}{HTML}{9F3FA1}
\definecolor{excolor}{HTML}{D18800}
\definecolor{notecolor}{HTML}{717182}
\definecolor{mylinkcolor}{HTML}{2655FF}

% Enumitem Settings

\setlist{listparindent=\parindent, parsep = 0pt, itemsep = 0pt, topsep = 0pt, labelindent = 2em, labelsep = 0.5em}

% ToC Settings

\hypersetup{
    colorlinks=true,
    linkcolor=mylinkcolor,
}

% Definition Settings

\newcommand{\defn}[1]{\noindent{\textcolor{defcolor}{\ding{117}~#1:}}}
\newcommand{\term}[1]{\textcolor{defcolor}{#1}}
\newtcolorbox{groupdef}{
    enhanced, arc=2mm,
    left=2pt, right=2pt, top=2pt, bottom=2pt,
    frame hidden, boxrule=0pt, colback=mypagecolor,
    borderline={1pt}{0pt}{defcolor, dashed},
}

% Theorem and Proposition Settings

\tcbset{
    importantenv/.style n args={2}{
        enhanced,
        left=7.5pt, right=7.5pt, top=4pt, bottom=4pt,
        sharp corners,
        arc=3mm,
        rounded corners=northeast,
        rounded corners=southwest,
        drop fuzzy shadow = #1!70,
        colback=#1!10!white, colframe=#1,
        colbacktitle=#1, coltitle=white,
        separator sign = {~\small\ding{228}},
        attach boxed title to top left={yshift=-0.5mm},
        interior style={
            top color=#1!25, bottom color=#1!5,
        },
        boxed title style={sharp corners, colframe=#1, colback=#1, arc=3mm, rounded corners=northeast},
        overlay={
            \node[circle, fill=#1, inner sep=0pt,minimum size=1.9em, text=white,
            ] at ($(title.north west)!0.5!(title.south west)$) {\Large#2};
        },
    }
}

% Lemma, Corollary, Example, and Note Settings

\tcbset{
    simplelineenv/.style n args={5}{
        enhanced, sharp corners,
        title={#1},
        boxrule=0pt,
        colback=mypagecolor, frame hidden,
        toptitle=0pt, bottomtitle=0pt,
        coltitle=#2, colbacktitle=mypagecolor,
        left=7.5pt, right=7.5pt, top=0pt, bottom=0pt,
        separator sign = {~\small\ding{228}},
        overlay={
            \node[
            inner sep=0pt,minimum size=1.5em, text=#3, #4,
            ] at ($(title.north west)!0.5!(title.south west)$) {\Large{#5}};
        },
        underlay={
            \draw[line width=2pt, #2] ($(title.south west)-(0,2pt)$) -- ($(frame.south west)+(0,2pt)$);
        }
    }
}

% Counter Settings

\newcounter{theocounter}[section]
\counterwithin{theocounter}{section}
\providecommand*{\theocounterautorefname}{Theorem}
\newcounter{propcounter}[section]
\counterwithin{propcounter}{section}
\providecommand*{\propcounterautorefname}{Proposition}
\newcounter{corcounter}[section]
\counterwithin{corcounter}{section}
\providecommand*{\corcounterautorefname}{Corollary}
\newcounter{lemcounter}[section]
\counterwithin{lemcounter}{section}
\providecommand*{\lemcounterautorefname}{Lemma}

% Environment Definitions

% Theorem Settings
\newtcbtheorem[
    use counter*=theocounter,
]{theo}{\hspace{1.82pt}\smash{Theorem}}{
    importantenv={theocolor}{\ding{170}}
}{theo}

\NewDocumentEnvironment{theorem}{O{}}{
    \stepcounter{propcounter}
    \stepcounter{corcounter}
    \stepcounter{lemcounter}
    \begin{theo}{\smash{#1}}{\thetcbcounter}
}{\end{theo}}

% Proposition Settings
\newtcbtheorem[
    use counter*=propcounter,
]{prop}{\smash{\hspace{1.82pt}Proposition}}{
    importantenv={propcolor}{\ding{168}}
}{prop}

\NewDocumentEnvironment{proposition}{O{}}{
    \stepcounter{corcounter}
    \stepcounter{lemcounter}
    \stepcounter{theocounter}
    \begin{prop}{\smash{#1}}{\thetcbcounter}
}{\end{prop}}

% Corollary Settings
\newtcbtheorem[
    use counter*=corcounter,
]{cor}{\smash{Corollary}}{
    simplelineenv={}{corcolor}{white}{circle, fill=corcolor}{\ding{171}}
}{cor}

\NewDocumentEnvironment{corollary}{O{}}{
    \stepcounter{lemcounter}
    \stepcounter{theocounter}
    \stepcounter{propcounter}
    \begin{cor}{\smash{#1}}{\thetcbcounter}
}{\end{cor}}

% Lemma Settings
\newtcbtheorem[
    use counter*=lemcounter,
]{lem}{Lemma}{
    simplelineenv={}{lemcolor}{white}{circle, fill=lemcolor}{\ding{70}}
}{lem}

\NewDocumentEnvironment{lemma}{O{}}{
    \stepcounter{theocounter}
    \stepcounter{propcounter}
    \stepcounter{corcounter}
    \begin{lem}{\smash{#1}}{\thetcbcounter}
}{\end{lem}}

% Example and Note Settings
\newtcolorbox{ex}[1][]{
    simplelineenv={Example}{excolor}{excolor}{}{\ding{46}},
    #1
}

\NewDocumentEnvironment{example}{o}{
    \IfValueTF{#1}
    {\begin{ex}[title={Example~{\small\ding{228}}~#1},bottomtitle=-4pt,]}
    {\begin{ex}}
}{\end{ex}}

\newtcolorbox{note}{
    simplelineenv={Note}{notecolor}{notecolor}{}{\ding{45}}
}

\csdef{pfsym@theo}{\ding{170}}
\csdef{pfsym@prop}{\ding{168}}
\csdef{pfsym@cor}{\ding{171}}
\csdef{pfsym@lem}{\ding{70}}

\NewDocumentEnvironment{pf}{O{}}{
    \ifcsdef{pfsym@#1}{
        \newcommand{\myheader}{\textcolor{#1color}{Proof of \csname the#1counter\endcsname}}
        \renewcommand{\qedsymbol}{\textcolor{#1color}{\csuse{pfsym@#1}}}
    }{
        \newcommand{\myheader}{\textcolor{black}{Proof}}
    }
    \begin{proof}[\myheader]
}{
    \end{proof}
}

\NewDocumentEnvironment{proofnum}{}{
    \begin{proof}
        \leavevmode
        \begin{enumerate}
}{
        \qedhere\end{enumerate}
    \end{proof}
}