\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{dummitstyle}

% Manual Settings

\RequirePackage{stickstootext}
\RequirePackage[stickstoo, vvarbb]{newtxmath}
\usetikzlibrary{arrows.meta, positioning, shadows, shapes.geometric}
\newcommand{\bookauthor}{D\&F}
\renewcommand{\arraystretch}{1.1}

% Color Settings

\definecolor{dummitbase}{HTML}{faecca}
\definecolor{mygreen}{HTML}{0DA327}
\colorlet{mygray}{black!54}
\colorlet{basecolor}{mygreen}
\colorlet{pagecolor}{dummitbase!50}
\definecolor{hintcolor}{HTML}{D92C26}
\definecolor{notecolor}{HTML}{4549AC}
\definecolor{remarkcolor}{HTML}{8A3196}
\definecolor{exerciseref}{HTML}{D62A52}
\colorlet{spsol}{MidnightBlue}

\newcommand{\defref}[1]{\hypersetup{linkcolor=red}\hyperref[def:#1]{#1}}

% Counter Settings

\counterwithin{equation}{section}
\newcounter{exercount}[subsection]
\renewcommand{\theexercount}{\thesubsection.\arabic{exercount}}
\newcommand{\exercountautorefname}{Exercise}
\renewcommand{\subsectionautorefname}{Section}

% Environments

\newtcbtheorem[use counter*=exercount]{exer}{Exercise}{
    dummitexercise,
}{ex}

\NewDocumentEnvironment{spex}{m o}
{
    \IfValueTF{#2}
    {\def\spextitle{Exercise~\theexercount:~#2}}
    {\def\spextitle{Exercise~\theexercount}}
    \begin{exer}[
        title = \spextitle,
        drop fuzzy shadow = blue!20,
        colback=RoyalBlue!8, colframe=CadetBlue!60,
        colbacktitle=BlueViolet!15, coltitle=MidnightBlue,
        boxed title style ={colframe=NavyBlue!70}
    ]{}{#1}
}{\end{exer}}

\newtcolorbox{lemmabox}{%
    enhanced, sharp corners,%
    boxrule=0pt, frame hidden,%
    colback = dummitbase!70,%
    borderline west={1.5pt}{0pt}{mygray},%
    left=7.5pt, right=5.5pt, top=4pt, bottom=4pt,%
    before skip=10pt, after skip=10pt%
}

\newenvironment{lemma}[1]{%
    \begin{lemmabox}{\textcolor{mygray}{\textbf{\emph{Lemma.}}~{#1}}}%
        \renewcommand{\qedsymbol}{\textcolor{mygray}{$\blacksquare$}}%
        \vspace{-1ex}
        \begin{proof}%
}{%
    \end{proof}%
\end{lemmabox}%
}

% Custom Commands Fixing Font Issues
\let\oldpmatrix\pmatrix
\let\oldendpmatrix\endpmatrix
\renewenvironment{pmatrix}[1][]{%
    \renewcommand{\arraystretch}{0.9}%
    \oldpmatrix
}{%
  \oldendpmatrix
}
\renewcommand{\semidir}{\mathbin{\raisebox{-0.20pt}[\height]{\scalebox{1.04}[1.30]{$\rtimes$}}}}
\renewcommand{\pmod}[1]{\mkern4mu(\operatorname{mod}\mkern3mu#1)}

% Cycles Command

\ExplSyntaxOn
\NewDocumentCommand{\cyc}{m}{
    \seq_set_split:Nnn \l_tmpa_seq { ~ } {#1}
    ( \seq_use:Nn \l_tmpa_seq {\ } )
}
\ExplSyntaxOff

\endinput