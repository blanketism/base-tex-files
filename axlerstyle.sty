\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{axlerstyle}[2024/06/10 Axler Style File]

% Font Settings

\RequirePackage{epigrafica}
\RequirePackage[LGR,OT1]{fontenc}

% Page Setup Settings

\definecolor{manualnote}{HTML}{4B7A4E}
\pagecolor{ProcessBlue!3}

% Counter Settings

\renewcommand\thesubsection{\thesection\Alph{subsection}}
\newcounter{exercount}[subsection]
\renewcommand{\theexercount}{\thesubsection\arabic{exercount}}
\newcommand{\exercountautorefname}{Exercise}
\renewcommand{\subsectionautorefname}{Section}

% Environments

\newtcbtheorem[use counter*=exercount]{exer}% environment name
    {Exercise}% Title text
    {enhanced,
    toptitle=2pt, bottomtitle=2pt,
    arc=0pt, drop fuzzy shadow southeast,
    boxrule=0pt, %
    borderline west={2.5pt}{0pt}{CadetBlue},%
    colframe = gray!20, colback = White, %
    coltitle=black, fonttitle=\bfseries, %
    after skip=1.2\baselineskip, before skip=1.2\baselineskip%
    }%
{ex}

\newtcolorbox{apex}[1][]{%
    enhanced,
    title={Exercise \MakeUppercase{#1}},
    label=apex:#1,
    toptitle=2pt, bottomtitle=2pt,
    arc=0pt, drop fuzzy shadow southeast,
    boxrule=0pt, %
    colframe = Green!20, coltitle=black, %
    colback = White,
    fonttitle=\bfseries, %
    borderline west={2.5pt}{0pt}{ForestGreen},%
    after skip=1.2\baselineskip, before skip=1.2\baselineskip%
}

\newenvironment{exercise}[1][]{\begin{exer}{}{#1}}{\end{exer}}

\newenvironment{sol}{%
\begin{proof}[\emph{\textbf{\textcolor{CadetBlue}{Solution}}}]%
}{\end{proof}}

\newenvironment{sole}{%
\begin{proof}[\emph{\textbf{\textcolor{CadetBlue}{Solution}}}]%
    \leavevmode%
    \begin{subexercises}%
}{\qh\end{subexercises}\end{proof}}

\newenvironment{solitem}{%
\begin{proof}[\emph{\textbf{\textcolor{CadetBlue}{Solution}}}]%
    \leavevmode%
    \begin{itemize}%
}{\qh\end{itemize}\end{proof}}

% Custom Commands

\newcommand{\apexref}[1]{\hyperref[apex:#1]{\emph{Appendix \MakeUppercase{#1}}}}
\newcommand{\apnote}[2]{\textcolor{red!70}{\emph{\textbf{Appendix.} See \apexref{#1}{#2}}}}
\newcommand{\remark}[1]{\textcolor{manualnote}{\textbf{Manual Remark.}~\emph{#1}}}
\newcommand{\note}[1]{\textcolor{CadetBlue}{\textbf{Axler Note.}~\emph{#1}}}
\newcommand{\hint}[1]{\textcolor{Plum}{\textbf{Axler Hint.}~\emph{#1}}}

% Appendix Commands

\newenvironment{csp}{\begin{proof}[Civil Service Pigeon]\leavevmode}{\end{proof}}
\newenvironment{coole}{\begin{proof}[Coolempire93]\leavevmode}{\end{proof}}
\newenvironment{me}{\begin{proof}[blanketism]\leavevmode}{\end{proof}}

