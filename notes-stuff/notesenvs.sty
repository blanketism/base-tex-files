\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notesenvs}
\RequirePackage{pifont}
\RequirePackage{etoolbox}

% Color Settings

\definecolor{defcolor}{HTML}{592CD4}
\definecolor{theocolor}{HTML}{C42114}
\definecolor{propcolor}{HTML}{3EA8B5}
\definecolor{corcolor}{HTML}{2EA62F}
\definecolor{lemcolor}{HTML}{9F3FA1}
\definecolor{excolor}{HTML}{D18800}
\definecolor{notecolor}{HTML}{717182}
\definecolor{mylinkcolor}{HTML}{2655FF}

% Enumitem Settings

\setlist{listparindent=\parindent, parsep = 0pt, itemsep = 0pt, topsep = 0pt, labelindent = 2em, labelsep = 0.5em}

% ToC Settings

\hypersetup{
    colorlinks=true,
    linkcolor=mylinkcolor,
}

% Definition Settings

\newcommand{\defn}[1]{\noindent{\textcolor{defcolor}{{\small{\ding{117}}}~#1.}}}
\newcommand{\term}[1]{\textcolor{defcolor}{#1}}

\newlist{deflist}{itemize}{1}
\setlist[deflist,1]{label=\textcolor{defcolor}{\scriptsize\ding{117}}}

\newcommand{\note}{\noindent{\textcolor{notecolor}{\ding{45}~\textbf{Note.}~}}}

\newcommand{\notes@title}[2]{\smash{#1}\hspace{0.4em}#2}

\newcommand{\notes@leftstrip}{%
    \pgfpathrectangle{\pgfpointorigin}%
        {\pgfqpoint{\dimexpr\kvtcb@left@rule+0.5pt\relax}{\tcb@height}}%
    \pgfsetfillcolor{tcbcolframe}%
    \pgfusepath{fill}%
}

\tcbset{
    lightenv/.style={
        sharp corners,
        boxrule=0pt, leftrule=2pt, colframe=#1,
        frame engine=freelance, frame code=\notes@leftstrip,
        colback=#1!8,
        attach title to upper={\par\noindent},
        left=7.5pt, right=7.5pt, top=5pt, bottom=5pt,
        coltitle=#1, fonttitle=\bfseries,
        separator sign = {},
        description delimiters={(}{)},
        description font=\mdseries\upshape,
    }
}

\newcommand{\notes@resultnum}{\csname thetcb@cnt@theo\endcsname}

\newcommand{\notes@newresult}[6][use counter from=theo]{%
    \newtcbtheorem[#1, crefname={#4}{#5}]{#3}{\notes@title{#6}{#4}}{lightenv={#3color}}{#3}%
    \csdef{pfsym@#3}{#6}%
    \NewDocumentEnvironment{#2}{O{}}%
        {\begin{#3}{##1}{\thetcbcounter}}%
        {\end{#3}}%
}

% Environment Definitions (theorem must come first: it owns the counter)

\notes@newresult[number within=section]{theorem}{theo}{Theorem}{Theorems}{\ding{170}}
\notes@newresult{proposition}{prop}{Proposition}{Propositions}{\ding{168}}
\notes@newresult{corollary}{cor}{Corollary}{Corollaries}{\ding{171}}
\notes@newresult{lemma}{lem}{Lemma}{Lemmas}{\ding{70}}

% Example and Note Settings

\tcbset{
    simplelineenv/.style n args={5}{
        enhanced, sharp corners,
        before skip=0pt, after skip=1.2\baselineskip,
        title={#1},
        boxrule=0pt,
        colback=white, frame hidden,
        toptitle=0pt, bottomtitle=0pt,
        coltitle=#2, colbacktitle=white,
        left=7.5pt, right=7.5pt, top=0pt, bottom=0pt,
        separator sign = {~\small\ding{228}},
        overlay={
            \node[
            inner sep=0pt,minimum size=1.5em, text=#3, #4,
            ] at ($(title.north west)!0.5!(title.south west)$) {\Large{#5}};
        },
        underlay={
            \draw[line width=1.5pt, #2] ($(title.south west)-(0,1pt)$) -- ($(frame.south west)+(0,2pt)$);
        }
    }
}

\newtcolorbox{ex}[1][]{
    simplelineenv={Example}{excolor}{excolor}{}{\ding{46}},
    #1
}

\NewDocumentEnvironment{example}{o}{
    \IfValueTF{#1}
    {\begin{ex}[title={Example~{\small\ding{228}}~#1},bottomtitle=-4pt,]}
    {\begin{ex}}
}{\end{ex}}

\NewDocumentEnvironment{pf}{O{}}{
    \ifcsdef{pfsym@#1}{
        \newcommand{\myheader}{\textcolor{#1color}{Proof of \notes@resultnum}}
        \renewcommand{\qedsymbol}{\textcolor{#1color}{\csuse{pfsym@#1}}}
    }{
        \newcommand{\myheader}{\textcolor{black}{Proof}}
    }
    \begin{proof}[\myheader]
}{
    \end{proof}
}

\NewDocumentEnvironment{proofnum}{}{
    \begin{proof}
        \leavevmode
        \begin{enumerate}
}{
        \qedhere\end{enumerate}
    \end{proof}
}