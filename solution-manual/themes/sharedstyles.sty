\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sharedstyles}

% Fonts

\RequirePackage{newpxtext}
\RequirePackage{newpxmath}

% Color Settings

\definecolor{basecolor}{HTML}{2F489C}
\colorlet{pagecolor}{ProcessBlue!3}
\colorlet{hintcolor}{basecolor!90!white}
\colorlet{notecolor}{basecolor!75!white}
\colorlet{remarkcolor}{basecolor!50!white}
\definecolor{exerciseref}{HTML}{8855F2}
\definecolor{termcolor}{HTML}{3E63DE}
\definecolor{appendixcolor}{HTML}{DE4949}

% Page and Hyperref Settings

\pagecolor{pagecolor}

\hypersetup{
    colorlinks=true,
    linkcolor=basecolor,
    urlcolor=red}
\fancyfoot[R]{\hypersetup{linkcolor=basecolor}\hyperlink{clickabletoc}{Table of Contents}}

% Counter Settings

\newcounter{exercount}[subsection]
\newcounter{lemmacount}
\newcommand{\exercountautorefname}{Exercise}
\newcommand{\lemmacountautorefname}{Lemma}
\renewcommand{\subsectionautorefname}{Section}

\ifcsdef{blanket@exerformat}{}{\def\blanket@exerformat{\thesubsection.\arabic{exercount}}}
\renewcommand{\theexercount}{\blanket@exerformat}

% Exercise Environment

% Style

\tcbset{axlerstripe/.code={\colorlet{axlerstripe}{#1}}}

\tcbset{axlerexercise/.style={
    enhanced,
    toptitle=2pt, bottomtitle=2pt,
    arc=0pt, drop fuzzy shadow southeast,
    boxrule=0pt,
    axlerstripe=basecolor,
    borderline west={2.5pt}{0pt}{axlerstripe},
    colframe = gray!20, colback = White,
    coltitle=black, fonttitle=\bfseries,
    after skip=1.2\baselineskip, before skip=1.2\baselineskip
}}

\tcbset{specialexercise/.style={
    axlerstripe=exerciseref,
    colframe=exerciseref!15,
    colback=exerciseref!3,
}}

% Environments

\newtcbtheorem[use counter*=exercount]{exer}{Exercise}{axlerexercise}{ex}

\newtcolorbox{apex}[1]{%
    axlerexercise, axlerstripe=ForestGreen, colframe=Green!20,
    title={Exercise \MakeUppercase{#1} \hyperref[ex:#1]{\ding{52}}},
    label=apex:#1,
    before upper={\ifcsdef{blanket@apex@#1}{{\let\label\@gobble\csuse{blanket@apex@#1}}\par}{}},
}

\newtcbtheorem[use counter=lemmacount]{lem}{Lemma}{
    enhanced, frame hidden,
    arc=3mm,
    colframe=gray,
    colback=white,
    colbacktitle=basecolor!15!white,
    fonttitle=\bfseries,
    coltitle=black,
    toptitle=2pt, bottomtitle=2pt,
}{lem}

\NewDocumentEnvironment{lemma}{m}{
    \begin{lem}{}{#1}
}{\end{lem}}

\pgfkeysifdefined{/tcb/specialexercise/.@cmd}{}{\tcbset{specialexercise/.style={}}}
\tcbset{blanket@thisexercise/.style={}}

\newcommand{\apex@icon}[1]{\hyperref[apex:#1]{\ding{52}}}

\NewDocumentEnvironment{exercise}{s t! O{} m +b}{%
    \csgdef{blanket@apex@#4}{#5}%
    \IfBooleanT{#2}{\tcbset{blanket@thisexercise/.append style={specialexercise}}}%
    \IfBooleanTF{#1}{%
        \ifblank{#3}{\tcbset{blanket@thisexercise/.append style={separator sign none}}}{}%
        \begin{exer}[blanket@thisexercise]{#3\ifblank{#3}{}{~}\apex@icon{#4}}{#4}%
    }{%
        \begin{exer}[blanket@thisexercise]{#3}{#4}%
    }%
    #5%
    \end{exer}%
}{}

\newcommand{\exref}[1]{{\hypersetup{linkcolor=exerciseref}\textup{\autoref{ex:#1}}}}
\newcommand{\appendixex}[1]{\begin{apex}{#1}\end{apex}}

% Solution Environments

\NewDocumentEnvironment{sol}{}{%
    \begin{proof}[\emph{\textbf{Solution.}}]%
}{\end{proof}}

\NewDocumentEnvironment{soliff}{}{%
    \begin{sol}
        \leavevmode%

}{\end{sol}}

\NewDocumentEnvironment{solenum}{}{%
    \begin{sol}
        \leavevmode%
        \begin{subexercises}%
}{\qedhere\end{subexercises}\end{sol}}

\NewDocumentEnvironment{solitem}{}{%
    \begin{sol}
        \leavevmode%
        \begin{itemize}%
}{\qedhere\end{itemize}\end{sol}}

% Shared Commands

\newcommand{\hint}[1]{{\color{hintcolor}\textbf{\bookauthor~Hint.}}~\emph{#1}}
\newcommand{\note}[1]{{\color{notecolor}\textbf{\bookauthor~Note.}}~\emph{#1}}
\newcommand{\remark}[1]{{\color{remarkcolor}\textbf{Manual~Remark.}}~\emph{#1}}
\newcommand{\term}[1]{\textcolor{termcolor}{\textbf{\textup{#1}}}}

\endinput